plot3
plot4 <- ggplot(plot_data_definition, aes(x = year, y = incidence_per_1000py, color = asthma_type)) +
geom_line(linewidth = 1.1) +
geom_point(size = 1.8) +
scale_color_manual(values = c("Asthma_possible" = "#1b9e77", "Asthma_narrow" = "#d95f02")) +
scale_x_continuous(breaks = seq(2010, 2022, by = 1)) +
labs(
title = "Possible vs Narrow Definition Comparison Over Time",
x = "Year",
y = "Incidence rate per 1,000 person-years",
color = "Definition"
) +
theme_minimal()
plot4
plot5 <- ggplot(forest_data, aes(
y = row_label,
x = incidence_per_1000py,
xmin = ci_lower,
xmax = ci_upper,
color = sex
)) +
geom_errorbar(width = 0.18, linewidth = 0.8, orientation = "y") +
geom_point(size = 2.4) +
facet_wrap(~asthma_type, ncol = 1, scales = "free_x") +
scale_color_manual(values = c("Female" = "#c44e52", "Male" = "#4c72b0")) +
labs(
title = "Forest Plot of Incidence Rates by Age Band and Sex (2010-2022)",
x = "Incidence rate per 1,000 person-years (95% CI)",
y = "Stratum",
color = "Sex"
) +
theme_minimal()
plot5
