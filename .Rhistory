facet_wrap(~asthma_type, ncol = 1) +
scale_fill_manual(values = c("Female" = "#c44e52", "Male" = "#4c72b0")) +
labs(
title = "Age-Band Incidence Comparison by Sex (Pooled 2010-2022)",
x = "Age band",
y = "Incidence rate per 1,000 person-years",
fill = "Sex"
) +
theme_minimal()
plot2
plot3 <- ggplot(plot_data_heatmap, aes(x = year, y = age_band, fill = incidence_per_1000py)) +
geom_tile(color = "white", linewidth = 0.2) +
facet_grid(asthma_type ~ sex) +
scale_x_continuous(breaks = seq(2010, 2022, by = 2)) +
scale_fill_gradient(low = "#f7fbff", high = "#08306b") +
labs(
title = "Year x Age-Band Heatmap of Incidence Rates",
x = "Year",
y = "Age band",
fill = "IR / 1,000 PY"
) +
