knitr::opts_chunk$set(echo = TRUE)
options(readr.show_col_types = FALSE)
# Loading in the needed libraries
library(readr)
library(readxl)
library(dplyr)
library(lubridate)
library(tidyr)
library(ggplot2)
# Loading in the data
persons <- read_csv("Data/PERSONS.csv")
# Loading in the data
persons <- read_csv("../Data/PERSONS.csv")
observation_periods <- read_csv("../Data/OBSERVATION_PERIODS.csv")
events <- read_csv("../Data/EVENTS.csv")
asthma_codelist <- read_excel("../Codelist/R_ASTHMA_COV.xlsx")
# Checking the dimensions of the tables that we will be working with now
dim(persons)
dim(observation_periods)
dim(events)
print("---")
# Checking the names of the columns of the data
names(events)
print("---")
names(observation_periods)
print("---")
names(persons)
# Check for duplicate persons in the persons table
sum(duplicated(persons$person_id))
# Check for duplicates in the observation periods table
sum(duplicated(observation_periods))
# Check for duplicates in the events table
sum(duplicated(events))
events <- events %>% distinct()
# Checking if the person_id is missing from any of the persons, observation_periods, or events table
sum(is.na(persons$person_id))
sum(is.na(observation_periods$person_id))
sum(is.na(events$person_id))
sum(persons$person_id == "")
sum(observation_periods$person_id == "")
sum(events$person_id == "")
# Check if the persons table is missing values for sex_at_instance_creation, or year_of_birth
sum(is.na(persons$sex_at_instance_creation))
sum(is.na(persons$year_of_birth))
sum(persons$sex_at_instance_creation == "")
sum(persons$year_of_birth == "")
events <- events %>% distinct()
# Checking if the person_id is missing from any of the persons, observation_periods, or events table
sum(is.na(persons$person_id))
sum(is.na(observation_periods$person_id))
sum(is.na(events$person_id))
sum(persons$person_id == "")
sum(observation_periods$person_id == "")
sum(events$person_id == "")
# Check if the persons table is missing values for sex_at_instance_creation, or year_of_birth
sum(is.na(persons$sex_at_instance_creation))
sum(is.na(persons$year_of_birth))
sum(persons$sex_at_instance_creation == "")
sum(persons$year_of_birth == "")
# Check for invalid dates, where the observation end date is before the observation start date
sum(observation_periods$op_end_date < observation_periods$op_start_date)
# Easily check if we have birth years outside of the time requirements
summary(persons$year_of_birth)
# As the maximum is 2024, we want to check how many birth years are over 2022
sum(persons$year_of_birth > 2022)
# Check how many peoples death year is before their birth year
sum(
!is.na(persons$year_of_death) &
!is.na(persons$year_of_birth) &
persons$year_of_death < persons$year_of_birth
)
# Excluding entries with operation end_date before the operation start_date from the observation_periods table
observation_periods <- observation_periods %>%
filter(op_end_date >= op_start_date)
# Merging the persons and observation_periods table
study_population <- observation_periods %>%
inner_join(persons, by = "person_id")
# Quickly checking what these merged data sources look like
dim(study_population)
head(study_population)
# We remove everyone from the population that is born after 2022. We know that the lower bound will not exclude anyone as the earliest birth year is 1934, which means the person is less than 120 years old, also we don't have to look at missing values as these do not occur in this data source
study_population <- study_population %>%
filter(
year_of_birth <= 2022
)
# Make sure to replace the NA values from month_of_birth, day_of_birth, month_of_death, day_of_death, to be sure that the 15th of July is used.
study_population <- study_population %>%
mutate(
month_of_birth = replace_na(month_of_birth, "07"),
day_of_birth   = replace_na(day_of_birth, "15"),
month_of_death = replace_na(month_of_death, "07"),
day_of_death  = replace_na(day_of_death, "15"),
)
# Make sure that we create proper date format characters for the birth and death date in the study_population
study_population <- study_population %>%
mutate(
birth_date = ymd(paste(year_of_birth, month_of_birth, day_of_birth, sep = "-")),
death_date = ymd(paste(year_of_death, month_of_death, day_of_death, sep = "-"))
)
# Make sure that the op_start_date and op_end_date are properly converted to the dates
study_population <- study_population %>%
mutate(
op_start_date = ymd(op_start_date),
op_end_date   = ymd(op_end_date)
)
# Make sure that start_date_record from events is properly converted to a date
events <- events %>%
mutate(
start_date_record = ymd(start_date_record)
)
# Quickly show an overview of what these dates look like
summary(study_population$birth_date)
summary(study_population$death_date)
summary(study_population$op_start_date)
summary(events$start_date_record)
# Define the start and end dates of the observation
study_start <- as.Date("2010-01-01")
study_end   <- as.Date("2022-12-31")
# Exclude all entries with an observation end date before the start of the observation time period, or a start date outside of the observation time period
study_population <- study_population %>%
filter(
op_end_date >= study_start,
op_start_date <= study_end
)
# Exclude all entries where the observation end date is before the observation start date
study_population <- study_population %>%
filter(op_end_date > op_start_date)
# As it is also stated that we will only be looking at "M", and "F", we will want to remove all other entries where the `sex_at_instance_creation` is not "M", or "F"
study_population <- study_population %>%
filter(sex_at_instance_creation %in% c("M", "F"))
# Quickly show the column names and the first few entries of the table
names(asthma_codelist)
head(asthma_codelist)
# Check which coding systems are available in the data source
table(asthma_codelist$"Coding system")
# Check if the coding system is missing anywhere
sum(is.na(asthma_codelist$"Coding system"))
sum(asthma_codelist$"Coding system" == "")
sum(asthma_codelist$"Coding system" == "-")
# Check if there are any codes missing.
sum(is.na(asthma_codelist$Code))
sum(asthma_codelist$Code == "")
sum(asthma_codelist$Code == "-")
# Remove entries from the asthma_codelist if the value in "Code" is "-"
asthma_codelist <- asthma_codelist %>%
filter(`Code` != "-")
asthma_codelist
# Extract specific codes based on tags for filtering events
narrow_codes <- asthma_codelist %>% filter(Tags == "Narrow") %>% pull(Code)
possible_codes <- asthma_codelist %>% filter(Tags %in% c("Narrow", "possible")) %>% pull(Code)
# Identify the first Asthma_narrow event date for each person to determine censoring
first_event_dt <- events %>%
filter(event_code %in% narrow_codes) %>%
group_by(person_id) %>%
summarise(date_first_asthma = min(start_date_record, na.rm = TRUE)) %>%
ungroup()
# Join the censoring dates back to the study population
study_population <- study_population %>%
left_join(first_event_dt, by = "person_id")
# Calculate the final follow-up dates using existing study_start and study_end
study_population <- study_population %>%
mutate(
# Start of follow-up
fup_start = pmax(study_start, op_start_date),
# End of follow-up (censoring)
fup_end = pmin(study_end, op_end_date, death_date, date_first_asthma, na.rm = TRUE)
) %>%
# Ensure follow-up duration is positive
filter(fup_start < fup_end)
# Split follow-up into yearly records and assign age bands
py_stratified <- study_population %>%
rowwise() %>%
# Create a sequence of years covered by the follow-up
mutate(year = list(year(fup_start):year(fup_end))) %>%
unnest(year) %>%
mutate(
# Dates within the specific calendar year
yr_start = pmax(fup_start, as.Date(paste0(year, "-01-01"))),
yr_end   = pmin(fup_end, as.Date(paste0(year, "-12-31"))),
# Calculate person-years for the year
days = as.numeric(yr_end - yr_start) + 1,
person_years = days / 365.25,
# Assign dynamic age bands based on the year
age_at_year = year - year_of_birth,
age_band = case_when(
age_at_year >= 0  & age_at_year <= 19 ~ "0-19",
age_at_year >= 20 & age_at_year <= 39 ~ "20-39",
age_at_year >= 40 & age_at_year <= 59 ~ "40-59",
age_at_year >= 60 ~ "60+",
TRUE ~ NA_character_
)
) %>%
filter(!is.na(age_band))
# Aggregate denominators
denominator_data <- py_stratified %>%
group_by(year, sex_at_instance_creation, age_band) %>%
summarise(total_person_years = sum(person_years), .groups = "drop")
# Preview the aggregated person-years
head(denominator_data)
asthma_events <- events %>%
filter(event_code %in% possible_codes) %>%
mutate(
asthma_type = case_when(
event_code %in% narrow_codes ~ "Asthma_narrow",
TRUE ~ "Asthma_possible"
)
)
# Merge asthma events with study population follow-up dates
asthma_events <- asthma_events %>%
inner_join(
study_population %>%
select(person_id, fup_start, fup_end, birth_date, year_of_birth, sex_at_instance_creation),
by = "person_id"
) %>%
# Keep only events occurring during follow-up
filter(
start_date_record >= fup_start,
start_date_record <= fup_end
) %>%
# Define year and age band at event
mutate(
year = year(start_date_record),
age_at_event = year - year_of_birth,
age_band = case_when(
age_at_event >= 0  & age_at_event <= 19 ~ "0-19",
age_at_event >= 20 & age_at_event <= 39 ~ "20-39",
age_at_event >= 40 & age_at_event <= 59 ~ "40-59",
age_at_event >= 60 ~ "60+",
TRUE ~ NA_character_
)
) %>%
filter(!is.na(age_band)) %>%
# Count only one event per subject per stratum
distinct(person_id, year, age_band, asthma_type, .keep_all = TRUE)
# Aggregate numerator counts
numerator_data <- asthma_events %>%
group_by(year, sex_at_instance_creation, age_band, asthma_type) %>%
summarise(events = n(), .groups = "drop")
# Preview event counts
head(numerator_data)
asthma_types <- c("Asthma_possible", "Asthma_narrow")
# Join numerators and denominators for every stratum
incidence_data <- denominator_data %>%
crossing(asthma_type = asthma_types) %>%
left_join(
numerator_data,
by = c("year", "sex_at_instance_creation", "age_band", "asthma_type")
) %>%
mutate(
events = replace_na(events, 0L),
incidence_per_1000py = if_else(
total_person_years > 0,
(events / total_person_years) * 1000,
NA_real_
)
) %>%
arrange(asthma_type, year, sex_at_instance_creation, age_band)
# Preview incidence by stratum
head(incidence_data)
# Full stratum-level table (year, sex, age band, definition)
incidence_table_stratum <- incidence_data %>%
mutate(
sex = recode(sex_at_instance_creation, "F" = "Female", "M" = "Male"),
total_person_years = round(total_person_years, 2),
incidence_per_1000py = round(incidence_per_1000py, 3)
) %>%
select(
year, sex, age_band, asthma_type, events,
total_person_years, incidence_per_1000py
) %>%
arrange(asthma_type, year, sex, age_band)
# Yearly table by sex and definition (aggregated over age bands)
incidence_table_year_sex <- incidence_data %>%
group_by(year, sex_at_instance_creation, asthma_type) %>%
summarise(
events = sum(events),
total_person_years = sum(total_person_years),
incidence_per_1000py = (events / total_person_years) * 1000,
.groups = "drop"
) %>%
mutate(
sex = recode(sex_at_instance_creation, "F" = "Female", "M" = "Male"),
total_person_years = round(total_person_years, 2),
incidence_per_1000py = round(incidence_per_1000py, 3)
) %>%
select(year, sex, asthma_type, events, total_person_years, incidence_per_1000py) %>%
arrange(asthma_type, year, sex)
# Overall table (2010-2022 pooled) by sex and definition
incidence_table_overall <- incidence_data %>%
group_by(sex_at_instance_creation, asthma_type) %>%
summarise(
events = sum(events),
total_person_years = sum(total_person_years),
incidence_per_1000py = (events / total_person_years) * 1000,
.groups = "drop"
) %>%
mutate(
sex = recode(sex_at_instance_creation, "F" = "Female", "M" = "Male"),
total_person_years = round(total_person_years, 2),
incidence_per_1000py = round(incidence_per_1000py, 3)
) %>%
select(sex, asthma_type, events, total_person_years, incidence_per_1000py) %>%
arrange(asthma_type, sex)
# Preview the tables that can be inserted in the report
knitr::kable(
incidence_table_overall,
caption = "Overall incidence rates (2010-2022 pooled), by sex and asthma definition"
)
knitr::kable(
incidence_table_year_sex,
caption = "Yearly incidence rates by sex and asthma definition"
)
rmarkdown::paged_table(incidence_table_stratum)
dir.create("tables", showWarnings = FALSE, recursive = TRUE)
write_csv(incidence_table_stratum, "tables/incidence_table_stratum.csv")
write_csv(incidence_table_year_sex, "tables/incidence_table_year_sex.csv")
write_csv(incidence_table_overall, "tables/incidence_table_overall.csv")
# Consistent labels/order for plots
age_levels <- c("0-19", "20-39", "40-59", "60+")
incidence_data <- incidence_data %>%
mutate(
age_band = factor(age_band, levels = age_levels),
sex = recode(sex_at_instance_creation, "F" = "Female", "M" = "Male")
)
# Yearly trend by sex, split by definition
plot_data_trend_sex <- incidence_data %>%
group_by(year, sex, asthma_type) %>%
summarise(
events = sum(events),
total_person_years = sum(total_person_years),
incidence_per_1000py = (events / total_person_years) * 1000,
.groups = "drop"
)
# Age-band comparison by sex, pooled over 2010-2022
plot_data_age_band <- incidence_data %>%
group_by(age_band, sex, asthma_type) %>%
summarise(
events = sum(events),
total_person_years = sum(total_person_years),
incidence_per_1000py = (events / total_person_years) * 1000,
.groups = "drop"
)
# Heatmap data (year x age-band), stratified by sex and definition
plot_data_heatmap <- incidence_data %>%
group_by(year, age_band, sex, asthma_type) %>%
summarise(
events = sum(events),
total_person_years = sum(total_person_years),
incidence_per_1000py = (events / total_person_years) * 1000,
.groups = "drop"
)
# Possible vs narrow overall trend
plot_data_definition <- incidence_data %>%
group_by(year, asthma_type) %>%
summarise(
events = sum(events),
total_person_years = sum(total_person_years),
incidence_per_1000py = (events / total_person_years) * 1000,
.groups = "drop"
)
# Forest-plot data (pooled 2010-2022) with exact Poisson 95% CIs
forest_data <- incidence_data %>%
group_by(age_band, sex, asthma_type) %>%
summarise(
events = sum(events),
total_person_years = sum(total_person_years),
.groups = "drop"
) %>%
mutate(
incidence_per_1000py = (events / total_person_years) * 1000,
ci_lower = if_else(
events == 0,
0,
(0.5 * qchisq(0.025, 2 * events) / total_person_years) * 1000
),
ci_upper = (0.5 * qchisq(0.975, 2 * (events + 1)) / total_person_years) * 1000,
row_label = factor(
paste(age_band, sex, sep = " - "),
levels = rev(as.vector(outer(age_levels, c("Female", "Male"), paste, sep = " - ")))
)
)
plot1 <- ggplot(plot_data_trend_sex, aes(x = year, y = incidence_per_1000py, color = sex)) +
geom_line(linewidth = 1) +
geom_point(size = 1.7) +
facet_wrap(~asthma_type, ncol = 1) +
scale_color_manual(values = c("Female" = "#c44e52", "Male" = "#4c72b0")) +
scale_x_continuous(breaks = seq(2010, 2022, by = 1)) +
labs(
title = "Yearly Incidence Trend by Sex",
x = "Year",
y = "Incidence rate per 1,000 person-years",
color = "Sex"
) +
theme_minimal()
